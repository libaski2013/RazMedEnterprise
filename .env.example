# Local development only. Leave unset on Railway so the app uses its own /api endpoint.
VITE_API_URL=http://localhost:4000/api

# Backend production configuration (set these in Railway, never commit real values).
MONGODB_URI=mongodb://localhost:27017/razmed
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=https://razmedenterprise-production.up.railway.app
NODE_ENV=development
