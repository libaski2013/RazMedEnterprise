PORT=4000
# Leave MONGODB_URI blank during local development and the server will
# auto-start a local, file-backed MongoDB (data kept in server/.mongo-data).
# For production, paste the complete MongoDB Atlas connection string in the
# deployment environment. Never commit the real value.
MONGODB_URI=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORS_ORIGIN=http://localhost:5173
